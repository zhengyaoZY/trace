# Server-only Web Service AK: enable Place API 3.0 and coordinate conversion.
BAIDU_SERVER_AK=
PORT=3000
HOST=0.0.0.0

# Only expose to a trusted LAN for development; public HTTPS deployment is separate.
BIND_ADDRESS=127.0.0.1

# Default v2 provider: AMap Web service key, coordinate conversion and POI search 2.0.
AMAP_SERVER_KEY=
